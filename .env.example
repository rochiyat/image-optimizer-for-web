# Image Optimization Configuration

# Processor Selection: 'sharp' or 'cloudinary'
IMAGE_PROCESSOR=sharp

# Optimization Settings
MAX_SIZE_KB=400
QUALITY=85
MAX_DIMENSION=2000

# Naming Strategy: 'original', 'folder', or 'timestamp'
IMAGE_NAMING_STRATEGY=original

# Directories
SOURCE_DIR=./temp-uploads
OUTPUT_DIR=./public/images/gallery

# Cloudinary Configuration (only if using cloudinary processor)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_FOLDER=gallery

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/optimization.log

# Performance
CONCURRENCY=3

# Validation
MAX_FILE_SIZE_MB=50
