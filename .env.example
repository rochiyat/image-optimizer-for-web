# Environment Variables Template
# Copy this to .env.local in your Next.js project

# ============================================
# CLOUDINARY CONFIGURATION
# ============================================
# For user uploads (registration photos, etc)

NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_upload_preset

# Optional: Untuk server-side operations
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ============================================
# IMAGE OPTIMIZATION SETTINGS
# ============================================

# Default quality for Next.js Image component
NEXT_PUBLIC_IMAGE_QUALITY=85

# CDN domain (jika pakai custom CDN)
# NEXT_PUBLIC_CDN_DOMAIN=cdn.yourdomain.com

# File naming strategy for optimized images
# Options: 
#   - "original" : Keep original filename (default)
#   - "folder"   : Use folder name + sequential number (e.g., event-001.jpg, event-002.jpg)
IMAGE_NAMING_STRATEGY=original

# ============================================
# NOTES
# ============================================

# Static gallery images:
# - Stored in: public/images/gallery/
# - Served via: Vercel/Netlify CDN
# - No Cloudinary needed for static gallery

# Dynamic user uploads:
# - Stored in: Cloudinary
# - Used for: registration photos, user submissions
# - Requires CLOUDINARY_* credentials

# ============================================
# USAGE EXAMPLES
# ============================================

# In your components:
# const cloudinaryUrl = `https://res.cloudinary.com/${process.env.NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME}/image/upload/...`

# For uploads:
# Use NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET in client-side upload widget
