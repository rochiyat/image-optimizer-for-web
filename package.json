{
  "name": "image-optimizer-for-web",
  "version": "1.0.0",
  "description": "Web komunitas dengan optimasi gambar",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "images:optimize": "node scripts/optimize-images.js",
    "images:optimize:v2": "node scripts/optimize-images-v2.js",
    "images:check": "find public/images -type f -exec du -h {} \\; | sort -rh | head -20",
    "images:check-large": "find public/images -type f -size +500k -exec ls -lh {} \\; | awk '{print $5, $9}'",
    "images:clean-temp": "rm -rf temp-uploads/*",
    "images:stats": "node scripts/check-image-stats.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "next": "^14.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwindcss": "^3.3.0",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.31"
  },
  "devDependencies": {
    "dotenv": "^17.2.3",
    "glob": "^10.3.10",
    "sharp": "^0.33.0",
    "cloudinary": "^1.41.0",
    "formidable": "^3.5.1",
    "archiver": "^6.0.1",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.8"
  }
}
