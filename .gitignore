# ===================================
# IMAGE OPTIMIZATION FILES
# ===================================

# Jangan commit folder temp uploads (original files)
/temp-uploads/
/temp-uploads/**/*

# Jangan commit hasil optimasi dari bulk upload
/public/images/optimized/
/public/images/optimized/**/*

# Vercel serverless temporary files
/tmp/
/tmp/**/*

# Jangan commit original files (yang belum dioptimize)
**/*-original.jpg
**/*-original.jpeg
**/*-original.png
**/*-original.JPG
**/*-original.JPEG
**/*-original.PNG

# Optional: Jangan commit files yang terlalu besar (> 1MB)
# Uncomment jika mau strict
# **/images/**/*.jpg
# **/images/**/*.jpeg
# !**/images/**/*-optimized.jpg

# macOS
.DS_Store
**/.DS_Store

